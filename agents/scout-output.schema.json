{
  "type": "object",
  "additionalProperties": false,
  "required": ["batches", "notes"],
  "properties": {
    "notes": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 2000 } },
    "batches": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["cluster", "leads"],
        "properties": {
          "cluster": {
            "type": "object", "additionalProperties": false, "required": ["label", "source", "unserved_score"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 200 },
              "source": { "type": "string", "minLength": 1, "maxLength": 100 },
              "unserved_score": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "leads": {
            "type": "array", "minItems": 1, "maxItems": 10,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "url", "contact_url", "email", "external_id", "data"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 300 },
                "url": { "type": ["string", "null"] },
                "contact_url": { "type": ["string", "null"] },
                "email": { "type": ["string", "null"] },
                "external_id": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "data": {
                  "type": "object", "required": ["evidence", "issues", "observed_at", "discovery_query", "buyer_type", "channel", "revenue"],
                  "properties": {
                    "buyer_type": { "type": "string", "enum": ["business", "consumer", "agent"] },
                    "channel": { "type": "string", "enum": ["contact_form", "email", "x_reply", "reddit_reply", "hn_reply", "github_issue_reply"] },
                    "revenue": {
                      "type": "object", "required": ["payer", "offer", "model", "price_usd", "channel", "channel_ready"],
                      "properties": {
                        "payer": { "type": "string", "minLength": 1 },
                        "offer": { "type": "string", "minLength": 1 },
                        "model": { "type": "string", "enum": ["one_time", "monthly", "per_call"] },
                        "price_usd": { "type": "number", "minimum": 0 },
                        "channel": { "type": "string", "minLength": 1 },
                        "channel_ready": { "type": "boolean" },
                        "note": { "type": "string" }
                      }
                    },
                    "evidence": {
                      "type": "array", "minItems": 1, "maxItems": 10,
                      "items": {
                        "type": "object", "additionalProperties": false, "required": ["url", "observation"],
                        "properties": {
                          "url": { "type": "string", "minLength": 1 },
                          "observation": { "type": "string", "minLength": 1, "maxLength": 2000 }
                        }
                      }
                    },
                    "issues": { "type": "array", "items": { "type": "string" } },
                    "observed_at": { "type": "string" },
                    "discovery_query": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
