# The dashboard demo runs without credentials. Copy this to .env.local for Naive setup.
# Keep credentials server-side; never prefix secrets with NEXT_PUBLIC_.
# Leave the key empty if using a saved official CLI login for local checks.
NAIVE_API_KEY=
NAIVE_API_BASE_URL=https://api.vetta.sh

# Set by the Naïve platform on the deployed foundry app; never set these by hand there.
# DATABASE_URL: the app's managed Postgres. VETTA_MCP_TOKEN: the bearer /mcp requires.
DATABASE_URL=
VETTA_MCP_TOKEN=
